{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://practice-intelligence/schema/payload/0.3.0",
  "title": "Practice Intelligence payload",
  "description": "Everything the renderer needs for ONE practice for ONE reporting period. Produced by the engine; the renderer does no calculation and shows real data only.",
  "type": "object",
  "required": ["schema_version", "run", "practice", "context", "assessment", "attention", "changes", "access_measures", "groups", "areas", "footer"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "0.3.0"},
    "run": {"type": "object", "required": ["id", "generated_at", "mode", "versions", "source_releases"],
      "properties": {"id": {"type": "string"}, "generated_at": {"type": "string", "format": "date-time"}, "mode": {"enum": ["fixture", "pipeline"]},
        "versions": {"type": "object", "required": ["schema", "metric_registry", "ruleset", "build"],
          "description": "Lets us tell 'the practice changed' from 'our method changed'.",
          "properties": {"schema": {"type": "string"}, "metric_registry": {"type": "string"}, "ruleset": {"type": "string"}, "build": {"type": "string"}}},
        "source_releases": {"type": "array", "items": {"type": "string"}, "description": "Raw releases used, as <source>/<period>; matches manifests/."}}},
    "practice": {"type": "object", "required": ["ods_code", "name", "icb", "pcn", "period"],
      "properties": {
        "ods_code": {"type": "string", "pattern": "^[A-Z][0-9]{5}$"},
        "name": {"type": "string"}, "icb": {"type": "string"},
        "pcn": {"type": "object", "required": ["name", "size"], "properties": {"name": {"type": "string"}, "size": {"type": "integer", "minimum": 1}}},
        "period": {"type": "object", "required": ["label", "end"], "properties": {"label": {"type": "string"}, "end": {"type": "string", "format": "date"}}}}},
    "context": {"type": "array", "maxItems": 4, "items": {"type": "object", "required": ["label", "value"],
      "properties": {"label": {"type": "string"}, "value": {"$ref": "#/$defs/val"}, "delta": {"$ref": "#/$defs/val"}, "hint": {"type": "string"}}}},
    "assessment": {"type": "object", "required": ["lines"],
      "properties": {"method": {"type": "string"},
        "lines": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "object", "required": ["status", "area", "text", "prov"],
          "properties": {"status": {"$ref": "#/$defs/status"}, "area": {"type": "string"}, "text": {"type": "string", "maxLength": 200}, "prov": {"$ref": "#/$defs/prov"}}}}}},
    "attention": {"type": "object", "required": ["area", "state", "title", "text", "metric", "metric_label", "compare", "scale_max", "why"],
      "properties": {
        "area": {"type": "string"},
        "state": {"enum": ["contract_attention", "early_warning", "emerging_pressure", "positive_signal"]},
        "title": {"type": "string"}, "text": {"type": "string", "maxLength": 220},
        "metric": {"$ref": "#/$defs/val"}, "metric_label": {"type": "string"},
        "compare": {"type": "array", "items": {"type": "object", "required": ["label", "value"], "properties": {"label": {"type": "string"}, "value": {"$ref": "#/$defs/val"}, "tone": {"$ref": "#/$defs/tone"}}}},
        "scale_max": {"type": "number"},
        "why": {"type": "array", "items": {"type": "string"}, "maxItems": 5, "description": "Plain-language reasons this outranked everything else (show the working)."}}},
    "changes": {"type": "object", "required": ["basis", "items"],
      "properties": {"basis": {"type": "string"},
        "items": {"type": "array", "maxItems": 3, "description": "0-3 items. Never padded: only changes that pass the materiality rules.",
          "items": {"type": "object", "required": ["label", "delta", "direction", "text", "series", "series_prov", "area"],
            "properties": {"label": {"type": "string"}, "delta": {"$ref": "#/$defs/val"}, "direction": {"enum": ["up", "down", "flat"]},
              "good": {"type": ["boolean", "null"]}, "text": {"type": "string", "maxLength": 80}, "series": {"type": "array", "items": {"type": "number"}, "minItems": 2},
              "series_prov": {"$ref": "#/$defs/prov"}, "area": {"type": "string"}, "flag": {"type": "string"}}}}}},
    "access_measures": {"type": "object", "required": ["items", "pending_text"],
      "properties": {"pending_text": {"type": "string"},
        "items": {"type": "array", "maxItems": 4, "items": {"type": "object", "required": ["label", "sub", "value", "status", "assurance", "bullet", "area"],
          "properties": {"label": {"type": "string"}, "sub": {"type": "string"}, "value": {"$ref": "#/$defs/val"}, "status": {"$ref": "#/$defs/status"},
            "assurance": {"$ref": "#/$defs/assurance"}, "footnote": {"type": "string"}, "area": {"type": "string"},
            "bullet": {"type": "object", "required": ["v", "max"], "properties": {"v": {"type": "number"}, "cmp": {"type": "number"}, "max": {"type": "number"}, "target": {"type": "number"}, "cmp_label": {"type": "string"}, "target_label": {"type": "string"}}}}}}}},
    "groups": {"type": "array", "items": {"type": "object", "required": ["id", "title", "question"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "question": {"type": "string"}}}},
    "areas": {"type": "object", "additionalProperties": {"$ref": "#/$defs/area"}},
    "footer": {"type": "object", "required": ["sources", "licence"], "properties": {"sources": {"type": "string"}, "licence": {"type": "string"}, "note": {"type": "string"}}}
  },
  "$defs": {
    "prov": {"enum": ["real", "illustrative", "mixed"], "description": "real = produced by the pipeline run; illustrative = fixture only, never displayed; mixed = element-level provenance inside"},
    "status": {"enum": ["attention", "watch", "normal", "good", "unable"]},
    "assurance": {"enum": ["contract_requirement", "national_ambition", "qof_threshold", "local_expectation", "benchmark", "none"],
      "description": "What the measure is judged against. Comes from the metric registry, never from copy. Never imply below-benchmark = breach."},
    "tone": {"enum": ["practice", "cmp", "crit", "warn", "good", "accent"]},
    "val": {"type": "object", "required": ["d", "prov"], "additionalProperties": false,
      "properties": {"d": {"type": "string", "description": "display string, already formatted"}, "v": {"type": ["number", "null"]}, "prov": {"enum": ["real", "illustrative"], "description": "Pipeline emits only 'real'. 'illustrative' is displayed only when run.mode is 'fixture'."},
        "base": {"type": "string", "description": "What a percentage is out of, e.g. 'of 2,827 answered calls'. Shown in small print."}}},
    "text_item": {"type": "object", "required": ["kind", "text", "prov"],
      "properties": {"kind": {"enum": ["association", "observed"]}, "text": {"type": "string"}, "prov": {"$ref": "#/$defs/prov"}}},
    "block": {"type": "object", "required": ["type"],
      "properties": {"type": {"enum": ["bullet_rows", "columns", "hbars", "lines", "heatmap", "outcomes", "table", "paired", "note"]},
        "title": {"type": "string"}, "note": {"type": "string"}, "prov": {"$ref": "#/$defs/prov"}}},
    "area": {"type": "object", "required": ["group", "title", "question", "status", "assurance", "priority"],
      "properties": {
        "group": {"type": "string"}, "title": {"type": "string"}, "question": {"type": "string"},
        "status": {"$ref": "#/$defs/status"}, "assurance": {"$ref": "#/$defs/assurance"},
        "priority": {"type": "object", "required": ["tier", "score_internal"], "description": "Ordering only; never displayed.",
          "properties": {"tier": {"enum": ["high", "medium", "low"]}, "reasons": {"type": "array", "items": {"type": "string"}}, "score_internal": {"type": "number"}, "ruleset": {"type": "string"}}},
        "wide": {"type": "boolean"},
        "availability": {"enum": ["available", "no_data", "unsupported", "not_built"], "default": "available",
          "description": "available = shown; no_data = source exists but nothing usable for this practice (inactive card with reason); unsupported = the data cannot provide it (hidden); not_built = possible but not calculated yet (hidden in pipeline mode)."},
        "unavailable_reason": {"type": "string"},
        "headline": {"type": "string", "maxLength": 90}, "metric": {"$ref": "#/$defs/val"}, "metric_label": {"type": "string"},
        "card": {"type": "array", "items": {"$ref": "#/$defs/block"}},
        "rank": {"type": "object", "required": ["pos", "n"], "description": "Position within PCN for this measure; favourable direction comes from the registry. Omitted when the PCN is too small, values are tied, or coverage differs.", "properties": {"pos": {"type": "integer"}, "n": {"type": "integer"}}},
        "trend": {"type": "object", "required": ["values", "prov"], "properties": {"values": {"type": "array", "items": {"type": "number"}}, "prov": {"$ref": "#/$defs/prov"}}},
        "patient_voice": {"type": "object", "required": ["text", "verdict"], "properties": {"text": {"$ref": "#/$defs/val"}, "verdict": {"enum": ["confirms", "consistent", "contradicts"]}}},
        "l2": {"type": "object", "required": ["what", "where", "investigate", "interpretation", "evidence"],
          "properties": {
            "what": {"type": "array", "maxItems": 4, "items": {"type": "object", "required": ["value", "label"], "properties": {"value": {"$ref": "#/$defs/val"}, "label": {"type": "string"}, "sub": {"type": "string"}}}},
            "where": {"type": "array", "items": {"$ref": "#/$defs/block"}},
            "investigate": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/text_item"}},
            "interpretation": {"type": "object", "required": ["text", "prov"], "description": "Deterministic templates now; an LLM may reword structured findings later.", "properties": {"text": {"type": "string", "maxLength": 360}, "prov": {"$ref": "#/$defs/prov"}}},
            "evidence": {"type": "object", "required": ["tested_on", "associations", "no_relationship", "sources", "comparators"],
              "properties": {"rule_version": {"type": "string", "description": "Evidence rule used. Without it, associations are not displayed in pipeline mode."}, "tested_on": {"type": "string"}, "associations": {"type": "array"}, "no_relationship": {"type": "array"}, "sources": {"type": "array", "items": {"type": "string"}}, "comparators": {"type": "string"}}}}},
        "l3": {"type": "object", "required": ["tabs"], "properties": {"tabs": {"type": "array", "minItems": 1,
          "items": {"type": "object", "required": ["id", "label", "blocks"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}}}}}}}
      },
      "allOf": [
        {"if": {"properties": {"availability": {"enum": ["available", "not_built"]}}, "required": ["availability"]}, "then": {"required": ["headline", "metric", "metric_label", "l2"]}},
        {"if": {"not": {"required": ["availability"]}}, "then": {"required": ["headline", "metric", "metric_label", "l2"]}},
        {"if": {"properties": {"availability": {"const": "no_data"}}, "required": ["availability"]}, "then": {"required": ["unavailable_reason"]}}
      ]
    }
  }
}
